# Скопировать в .env.local и заполнить реальными значениями.
# Настройки Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ключ Anthropic: https://console.anthropic.com/settings/keys
# Только на сервере. Никогда не добавлять префикс NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
